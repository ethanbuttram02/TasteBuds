# Copy this file to .env and fill in your values.
# Get a Client ID by creating an app at https://developer.spotify.com/dashboard

VITE_SPOTIFY_CLIENT_ID=37973ec4f89340d3839cc95022728349

# Must exactly match a Redirect URI you add in the Spotify Dashboard app settings.
# For local dev with `npm run dev` (Vite default port):
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000
